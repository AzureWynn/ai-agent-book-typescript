{
  "name": "local-llm-serving",
  "version": "1.0.0",
  "description": "Chapter 2-1: local LLM serving & tool calling, TypeScript port (Ollama native tool calling + streaming)",
  "private": true,
  "type": "module",
  "scripts": {
    "run": "tsx src/main.ts",
    "interactive": "tsx src/main.ts --mode interactive",
    "single": "tsx src/main.ts --mode single",
    "demo": "tsx src/main.ts --mode single --demo",
    "info": "tsx src/main.ts --info",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}