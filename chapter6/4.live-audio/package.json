{
  "name": "live-audio",
  "version": "1.0.0",
  "description": "Chapter 6-4: realtime voice loop (simplified) - ffmpeg record -> faster-whisper ASR -> Ollama -> macOS say (TypeScript)",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "tsx src/setup.ts",
    "run": "tsx src/main.ts",
    "demo": "tsx src/main.ts --mode demo",
    "offline": "tsx src/main.ts --mode demo --offline",
    "eval": "tsx src/main.ts --mode eval",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ollama": "^0.6.3",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}