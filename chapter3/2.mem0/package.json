{
  "name": "memory-framework-comparison",
  "version": "1.0.0",
  "description": "Chapter 3-2: mem0 vs memobase concepts in TypeScript, simplified comparison",
  "private": true,
  "type": "module",
  "scripts": {
    "run": "tsx src/main.ts",
    "mem0": "tsx src/main.ts --mode mem0",
    "memobase": "tsx src/main.ts --mode memobase",
    "compare": "tsx src/main.ts --mode compare",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openai": "^4.73.0",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
