    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ollama": "^0.6.3",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
