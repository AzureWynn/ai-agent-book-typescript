{
  "name": "paper-to-ppt",
  "version": "1.0.0",
  "description": "Chapter 5-6: paper to slides - single vs dual agent on pinned Attention paper, matplotlib slides, Vision scoring (TypeScript + Ollama)",
  "private": true,
  "type": "module",
  "scripts": {
    "run": "tsx src/main.ts",
